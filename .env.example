# Server/local tooling placeholders. Never expose secrets to browser bundles:
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Reserved; current DB-backed sessions do not use a signing secret
OPERATOR_AUTH_SECRET=
CARETAKER_API_KEY=
NARRATOR_API_KEY=
CRON_SECRET=
GROQ_API_KEY=
GROQ_MODEL=
# External caretaker client / local credential provisioner (not public variables)
WORLD_ID=
CARETAKER_ACTOR_ID=
VILLAGE_URL=
CREDENTIAL_ID=
ACTION_KEY=
# Disposable local integration tests only
TEST_DATABASE_URL=

# Local agent provisioning (role defaults to caretaker)
AGENT_ROLE=
AGENT_ACTOR_ID=
OPERATOR_API_KEY=
# Apply these per-world values using npm run narrator:settings
NARRATOR_MANUAL_APPROVAL=
NARRATOR_MIN_GAP_HOURS=
NARRATOR_RARE_GAP_HOURS=
NARRATOR_EARLIEST_DISCOVERY_DAY=
NARRATOR_MAX_EVENTS_PER_DAY=
NARRATOR_DAILY_REQUEST_LIMIT=
NARRATOR_DAILY_TOKEN_LIMIT=

# Operator website; set to the exact browser origin (scheme + host + port)
APP_ORIGIN=
# Explicit local development only; never enables controls on an unmarked live world
LOCAL_TEST_TOOLS_ENABLED=
# Optional trusted browser executable for local E2E
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Stateless scheduler (separate secret and one pinned live world)
CRON_WORLD_ID=
CRON_MAX_STEPS=
CRON_EXPECTED_INTERVAL_MS=
# One-shot worker retry and local-only recovery/HTTP-test tooling
TICK_REQUEST_ID=
RESTORE_DATABASE_URL=
RECOVERY_WORLD_ID=
SCHEDULER_TEST_CONTEXT=

# Local-only Phase 7 harness; never an existing production database target
EXPERIMENT_DATABASE_URL=
